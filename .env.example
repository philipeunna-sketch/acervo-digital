# ==========================================================================
# ACERVO DIGITAL - variaveis de ambiente
# Copie para `.env.local` (dev) ou configure na Vercel (producao).
# NUNCA versione um `.env` real. NUNCA exponha segredos em NEXT_PUBLIC_*.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. BANCO DE DADOS (OBRIGATORIO EM PRODUCAO)
# --------------------------------------------------------------------------
# URL de conexao Postgres do Supabase (pooler transacional, porta 6543).
# Formato: postgresql://USER:PASSWORD@HOST:6543/postgres
# Se nao definido, a aplicacao usa PGlite local em `.dev-data/pglite`
# (somente desenvolvimento - os dados nao sao compartilhados).
DATABASE_URL=
# URL direta do Postgres (opcional, porta 5432) - usada para migracoes.
DIRECT_URL=
# Desabilite RLS no cliente postgres.js (usado quando a conexao nao e
# superuser). Mantenha `false` em producao.
DISABLE_RLS=false

# --------------------------------------------------------------------------
# 2. AUTENTICACAO
# --------------------------------------------------------------------------
# `supabase` (producao) | `local` (desenvolvimento, sem dependencia externa)
AUTH_DRIVER=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL publica da aplicacao. Usada em links de e-mail, OAuth e callbacks.
# Ex.: https://acervo-digital.vercel.app
NEXT_PUBLIC_APP_URL=

# Recuperacao de senha por e-mail (opcional). Sem RESEND_API_KEY, o link e
# exibido no console apenas em desenvolvimento.
RESEND_API_KEY=
MAIL_FROM=Acervo Digital <no-reply@acervodigital.app>

# Segredo para assinar cookies de sessao (local driver) e tokens internos.
# Gere com: openssl rand -base64 48
SESSION_SECRET=
# Chave de 32 bytes (hex ou base64) para cifrar segredos de integracoes.
# Gere com: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# --------------------------------------------------------------------------
# 3. CONTA ADMINISTRATIVA INICIAL (bootstrap)
# --------------------------------------------------------------------------
# Somente lidos no servidor. A conta e criada uma unica vez, no primeiro boot.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Force a troca de senha no primeiro acesso do administrador.
BOOTSTRAP_FORCE_PASSWORD_CHANGE=true

# --------------------------------------------------------------------------
# 4. ARMAZENAMENTO (obrigatorio em producao)
# --------------------------------------------------------------------------
# Provedor padrao do acervo: `s3` (Wasabi/AWS S3) ou `local` (dev)
STORAGE_DRIVER=local
# Endpoint do servico S3-compativel (Wasabi: https://s3.<regiao>.wasabisys.com)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# `true` para Wasabi e outros provedores que exigem path-style
S3_FORCE_PATH_STYLE=true
# URL publica base (opcional) - por padrao os arquivos sao privados.
S3_PUBLIC_BASE_URL=
# Limites de upload (bytes)
MAX_UPLOAD_SIZE=5368709120
# Tamanho da parte do upload multipart (minimo 5MB para S3)
MULTIPART_PART_SIZE=16777216
# Numero de partes emitidas por vez (o cliente respeita este limite)
MULTIPART_MAX_PARTS=8
# Duracao (segundos) das URLs assinadas geradas para o navegador
SIGNED_URL_TTL=600

# --------------------------------------------------------------------------
# 5. GOOGLE DRIVE (opcional)
# --------------------------------------------------------------------------
GOOGLE_DRIVE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback
# Escopos solicitados (separados por virgula)
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/drive.file

# --------------------------------------------------------------------------
# 6. TELEGRAM (opcional)
# --------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# --------------------------------------------------------------------------
# 7. PROVEDOR DE IA (opcional)
# --------------------------------------------------------------------------
# `openai` (tambem compativel com Groq/OpenRouter/compatibles via baseURL)
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1500

# --------------------------------------------------------------------------
# 8. PROVEDOR DE PESQUISA (opcional)
# --------------------------------------------------------------------------
# `brave` | `tavily` | `serper` | `google`
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# --------------------------------------------------------------------------
# 9. TWITTER / X (opcional - API oficial)
# --------------------------------------------------------------------------
TWITTER_BEARER_TOKEN=

# --------------------------------------------------------------------------
# 10. SEGURANCA E LIMITES
# --------------------------------------------------------------------------
# `memory` (padrao, single instance) | `upstash` (multi-instance)
RATE_LIMIT_DRIVER=memory
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# User-Agent usado ao buscar conteudo publico (modulo Salvar conteudo)
FETCH_USER_AGENT=AcervoDigitalBot/1.0 (+https://acervodigital.app)
# Tamanho maximo (bytes) de midia importada de fontes externas
IMPORT_MAX_MEDIA_SIZE=104857600
# Segredo do cron de manutencao. A Vercel envia `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
# Segredo usado para assinar URLs do driver de armazenamento local
LOCAL_STORAGE_SIGNING_SECRET=
